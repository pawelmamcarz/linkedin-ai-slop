# Klucz TypeSafe — tylko po stronie proxy, nigdy w rozszerzeniu.
# Dashboard: https://typesafe.ai
TYPESAFE_API_KEY=

# Lokalny start bez PORT słucha na 127.0.0.1:8787.
# Gdy jest samo PORT (PaaS), a HOST puste, proces słucha na 0.0.0.0.
# Na Railway HOST jest ustawione na 0.0.0.0.
PORT=8787
HOST=127.0.0.1
# CORS: puste = linkedin.com + chrome-extension:// + moz-extension:// + safari-web-extension:// + pawelmamcarz.github.io + localhost
# CORS_ORIGIN=https://www.linkedin.com

# Publiczne demo: POST /evaluate, okno przesuwne na IP. 0 wyłącza.
# 60/min, bo rozszerzenie ma równoległość 2 i kolejkę 40. 30/min ucina szybki scroll.
EVALUATE_RATE_LIMIT=60
EVALUATE_RATE_WINDOW_MS=60000

# DEMO_MODE=1 włącza dobowy limit demo, gdy EVALUATE_DAILY_IP_CAP jest puste.
# Domyślna wartość tego hamulca to 200 ocen na IP na dobę (UTC).
# Jawne EVALUATE_DAILY_IP_CAP wygrywa (także 0 = wyłączone). Lokalne BYOK zostaw DEMO_MODE puste.
# Na Railway (publiczne demo) ustaw DEMO_MODE=1 albo EVALUATE_DAILY_IP_CAP=200.
# DEMO_MODE=1
# EVALUATE_DAILY_IP_CAP=200

# Tokeny Pro: przecinek. Wartość plain albo sha256:<64 hex>.
# Plain jest hashowany przy odczycie. Nie wklejaj tu TYPESAFE_API_KEY.
# Webhook dopisuje wydane tokeny do pamięci i, gdy ustawione, do PRO_TOKEN_FILE.
# PRO_TOKENS=sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# PRO_TOKEN_FILE=./data/pro-tokens.json

# Limity Pro (wyższe niż anonimowe demo). 0 wyłącza dany hamulec.
# Domyślnie 300 ocen / 60 s oraz 2000 ocen / dobę na IP.
# PRO_RATE_LIMIT=300
# PRO_RATE_WINDOW_MS=60000
# PRO_DAILY_CAP=2000

# Stripe Checkout (subskrypcja). Bez tych zmiennych GET /billing/checkout zwraca stronę „wkrótce”.
# Ceny w Dashboard: około 5 USD / miesiąc (STRIPE_PRICE_MONTHLY) i około 40 USD / rok (STRIPE_PRICE_YEARLY).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_YEARLY=price_...
# PUBLIC_BASE_URL=https://proxy-production-ebcc.up.railway.app
# BILLING_CONTACT_URL=https://github.com/pawelmamcarz/linkedin-ai-slop/issues
