{
  "manifest_version": 3,
  "name": "LinkedIn AI Slop",
  "version": "0.2.0",
  "description": "Oznacza posty na feedzie LinkedIn według oceny AI-slop. Klucz Jev zostaje na proxy, nie w rozszerzeniu.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://*.linkedin.com/*",
    "https://proxy-production-ebcc.up.railway.app/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "https://*.up.railway.app/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LinkedIn AI Slop",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["ext-api.js", "content.js"],
      "css": ["badge.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://127.0.0.1:8787/*", "http://localhost:8787/*"],
      "js": ["ext-api.js", "content.js"],
      "css": ["badge.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
