<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Dostęp do stron jest w manifeście Web Extension (extension/manifest.json),
  kopiowanym do bundla przez safari/sync-resources.sh:
    https://www.linkedin.com/*
    https://*.linkedin.com/*
    https://proxy-production-ebcc.up.railway.app/*
    http://127.0.0.1/*
    http://localhost/*
  com.apple.security.network.client pozwala procesowi rozszerzenia otworzyć te połączenia HTTP(S).
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
